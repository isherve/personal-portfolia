# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/greenrock?schema=public"

# Server
PORT=5001
NODE_ENV=development
API_URL=http://localhost:5001
WEB_URL=http://localhost:3001

# JWT
JWT_SECRET=green-rock-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=green-rock-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Green Rock <noreply@greenrock.com>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# CORS
CORS_ORIGIN=http://localhost:3001
