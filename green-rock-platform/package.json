{
  "name": "green-rock-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Green Rock General Supply Ltd - Unified Enterprise Management Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@green-rock/api",
    "dev:web": "npm run dev --workspace=@green-rock/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@green-rock/api",
    "db:migrate": "npm run db:migrate --workspace=@green-rock/api",
    "db:seed": "npm run db:seed --workspace=@green-rock/api",
    "db:studio": "npm run db:studio --workspace=@green-rock/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
